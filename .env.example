# Bu fayl namunadir — haqiqiy qiymatlarni .env.local ga yozing.
# .env.local git'ga tushmaydi.

# Telegram bot tokeni (@BotFather dan)
TELEGRAM_BOT_TOKEN=

# Yangi bronlar yuboriladigan admin chat ID (ixtiyoriy, botda /id orqali olinadi)
# ADMIN_CHAT_ID=

# Mini App manzili — HTTPS bo'lishi shart (`pnpm tunnel` avtomatik yangilaydi)
SITE_URL=http://localhost:3000

# Saytdagi "botga o'tish" havolasi uchun bot username'i yoki to'liq URL
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=primeclubrobot
# NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/primeclubrobot

# Klub ma'lumotlari (ixtiyoriy)
# CLUB_PHONE=+998 93 095 19 96
# CLUB_ADDRESS=Andijon viloyati, Baliqchi tumani, Chinobod shaharchasi
# CLUB_WORK_HOURS=Har kuni 09:00 - 00:00

# Test rejimi: kirish kodlari Telegramga yuborilmay, bot/data/dev-codes.log ga yoziladi
# AUTH_DEV_LOG_CODES=1
